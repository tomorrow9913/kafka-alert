<!DOCTYPE html
    PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title>Network Security Event Alert</title>
</head>

<body
    style="margin:0; padding:0; background-color:#f4f4f7; font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; -webkit-font-smoothing:antialiased; font-size:14px; line-height:1.5; color:#2d3748;">
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color:#f4f4f7; padding:40px 0;">
        <tr>
            <td align="center">

                <table border="0" cellpadding="0" cellspacing="0" width="600"
                    style="background-color:#ffffff; border-radius:12px; overflow:hidden; width:600px; max-width:600px; box-shadow:0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);">

                    <!-- Header -->
                    <tr>
                        <td align="center"
                            style="padding:35px 30px; border-bottom:1px solid #edf2f7; background-color:#ebf8ff;">
                            <div
                                style="display:inline-block; width:60px; height:60px; line-height:60px; border-radius:50%; margin-bottom:15px; font-size:28px; text-align:center; box-shadow:0 4px 6px rgba(0,0,0,0.05); background-color:#bee3f8; color:#2b6cb0;">
                                🌐
                            </div>

                            <h1
                                style="margin:0; font-size:22px; font-weight:800; letter-spacing:-0.5px; color:#2b6cb0;">
                                {{ payload.proc.event | upper if payload is defined and payload.proc is defined and
                                payload.proc.event is defined else 'UNKNOWN' }}
                            </h1>

                            <p style="margin:8px 0 0 0; color:#718096; font-size:14px; font-weight:500;">
                                네트워크 보안 이벤트가 감지되었습니다. (SSH 로그인 성공 시점 기준)
                            </p>

                            <p style="margin:10px 0 0 0; color:#718096; font-size:12px;">
                                Time : <strong style="color:#2d3748;">{{ time or 'Unknown' }}</strong>
                                &nbsp;&nbsp;•&nbsp;&nbsp;
                                Node: <strong style="color:#2d3748;">{{ node or 'Unknown' }}</strong>
                            </p>
                        </td>
                    </tr>

                    <!-- Body -->
                    <tr>
                        <td style="padding:35px;">

                            <!-- Section: Core -->
                            <div style="margin-bottom:25px;">
                                <span
                                    style="text-transform:uppercase; letter-spacing:0.05em; color:#a0aec0; font-size:11px; font-weight:700; display:block; margin-bottom:10px;">
                                    🧾 Event Summary
                                </span>

                                <table border="0" cellpadding="0" cellspacing="0" width="100%"
                                    style="background-color:#f8fafc; border:1px solid #edf2f7; border-radius:8px;">
                                    <tr>
                                        <td width="50%"
                                            style="padding:15px; border-right:1px solid #edf2f7; border-bottom:1px solid #edf2f7;">
                                            <span
                                                style="color:#718096; font-size:11px; font-weight:bold; display:block;">Node</span>
                                            <div style="color:#2d3748; font-family:monospace; font-size:13px;">{{ node
                                                or 'Unknown' }}</div>
                                        </td>
                                        <td width="50%" style="padding:15px; border-bottom:1px solid #edf2f7;">
                                            <span
                                                style="color:#718096; font-size:11px; font-weight:bold; display:block;">Login
                                                Event Time</span>
                                            <div style="color:#2d3748; font-family:monospace; font-size:13px;">{{ time
                                                or 'Unknown' }}</div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:15px; border-right:1px solid #edf2f7;">
                                            <span
                                                style="color:#718096; font-size:11px; font-weight:bold; display:block;">Last
                                                Seen</span>
                                            <div style="color:#2d3748; font-family:monospace; font-size:13px;">
                                                {{ last_seen if last_seen is defined and last_seen else 'N/A' }}
                                            </div>
                                        </td>
                                        <td style="padding:15px;">
                                            <span
                                                style="color:#718096; font-size:11px; font-weight:bold; display:block;">Event</span>
                                            <div style="color:#2d3748; font-family:monospace; font-size:13px;">
                                                {{ payload.proc.event | upper if payload is defined and payload.proc is
                                                defined and payload.proc.event is defined else 'UNKNOWN' }}
                                            </div>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Section: Correlation / Accept -->
                            <div style="margin-bottom:25px;">
                                <span
                                    style="text-transform:uppercase; letter-spacing:0.05em; color:#a0aec0; font-size:11px; font-weight:700; display:block; margin-bottom:10px;">
                                    🧩 Correlation / Accept Info
                                </span>

                                <table border="0" cellpadding="0" cellspacing="0" width="100%"
                                    style="border-collapse:separate; border-spacing:0;">
                                    <tr>
                                        <td
                                            style="padding:12px 15px; background-color:#2d3748; border-radius:6px 6px 0 0; color:#ffffff; font-weight:600; font-family:monospace;">
                                            <span
                                                style="color:#a0aec0; font-weight:normal; margin-right:8px;">sock_id:</span>
                                            {{ sock_id if sock_id is defined and sock_id else 'N/A' }}
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:0;">
                                            <table border="0" cellpadding="0" cellspacing="0" width="100%"
                                                style="border:1px solid #e2e8f0; border-top:0; border-radius:0 0 6px 6px;">
                                                <tr>
                                                    <td width="50%"
                                                        style="padding:12px 15px; border-right:1px solid #e2e8f0;">
                                                        <div
                                                            style="font-size:11px; color:#718096; font-weight:bold; margin-bottom:2px;">
                                                            Accept Time</div>
                                                        <div
                                                            style="font-family:monospace; font-size:13px; color:#2d3748;">
                                                            {{ accept_time if accept_time is defined and accept_time
                                                            else 'N/A' }}
                                                        </div>
                                                    </td>
                                                    <td width="50%" style="padding:12px 15px;">
                                                        <div
                                                            style="font-size:11px; color:#718096; font-weight:bold; margin-bottom:2px;">
                                                            Accept TS</div>
                                                        <div
                                                            style="font-family:monospace; font-size:13px; color:#2d3748;">
                                                            {{ accept_ts if accept_ts is defined and accept_ts else
                                                            'N/A' }}
                                                        </div>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Section: Network / Geo -->
                            <div style="margin-bottom:25px;">
                                <span
                                    style="text-transform:uppercase; letter-spacing:0.05em; color:#a0aec0; font-size:11px; font-weight:700; display:block; margin-bottom:10px;">
                                    🌍 Network / Geo
                                </span>

                                <table border="0" cellpadding="0" cellspacing="0" width="100%"
                                    style="background-color:#f8fafc; border:1px solid #edf2f7; border-radius:8px;">
                                    <tr>
                                        <td width="33%"
                                            style="padding:15px; border-right:1px solid #edf2f7; border-bottom:1px solid #edf2f7;">
                                            <span
                                                style="color:#718096; font-size:11px; font-weight:bold; display:block;">Country</span>
                                            <div style="color:#2d3748; font-family:monospace; font-size:13px;">
                                                {{ country_code if country_code is defined and country_code else 'N/A'
                                                }}
                                            </div>
                                        </td>
                                        <td width="33%"
                                            style="padding:15px; border-right:1px solid #edf2f7; border-bottom:1px solid #edf2f7;">
                                            <span
                                                style="color:#718096; font-size:11px; font-weight:bold; display:block;">Source
                                                IP</span>
                                            <div style="color:#2d3748; font-family:monospace; font-size:13px;">
                                                {{ src_ip if src_ip is defined and src_ip else 'N/A' }}
                                            </div>
                                        </td>
                                        <td width="33%" style="padding:15px; border-bottom:1px solid #edf2f7;">
                                            <span
                                                style="color:#718096; font-size:11px; font-weight:bold; display:block;">Destination
                                                IP</span>
                                            <div style="color:#2d3748; font-family:monospace; font-size:13px;">
                                                {{ dest_ip if dest_ip is defined and dest_ip else 'N/A' }}
                                            </div>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="50%" style="padding:15px; border-right:1px solid #edf2f7;">
                                            <span
                                                style="color:#718096; font-size:11px; font-weight:bold; display:block;">Protocol</span>
                                            <div style="color:#2d3748; font-family:monospace; font-size:13px;">
                                                {{ payload.net.proto if payload is defined and payload.net is defined
                                                and payload.net.proto is defined and payload.net.proto else 'N/A' }}
                                            </div>
                                        </td>
                                        <td width="50%" style="padding:15px;">
                                            <span
                                                style="color:#718096; font-size:11px; font-weight:bold; display:block;">Bytes</span>
                                            <div style="color:#2d3748; font-family:monospace; font-size:13px;">
                                                {{ payload.net.bytes if payload is defined and payload.net is defined
                                                and payload.net.bytes is defined and payload.net.bytes is not none else
                                                'N/A' }}
                                            </div>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Section: Process -->
                            <div style="margin-bottom:25px;">
                                <span
                                    style="text-transform:uppercase; letter-spacing:0.05em; color:#a0aec0; font-size:11px; font-weight:700; display:block; margin-bottom:10px;">
                                    ⚙️ Process Context
                                </span>

                                <table border="0" cellpadding="0" cellspacing="0" width="100%"
                                    style="border-collapse:separate; border-spacing:0;">
                                    <tr>
                                        <td
                                            style="padding:12px 15px; background-color:#2d3748; border-radius:6px 6px 0 0; color:#ffffff; font-weight:600; font-family:monospace;">
                                            <span
                                                style="color:#a0aec0; font-weight:normal; margin-right:8px;">Command:</span>
                                            {{ payload.proc.comm if payload is defined and payload.proc is defined and
                                            payload.proc.comm is defined and payload.proc.comm else 'N/A' }}
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="padding:0;">
                                            <table border="0" cellpadding="0" cellspacing="0" width="100%"
                                                style="border:1px solid #e2e8f0; border-top:0; border-radius:0 0 6px 6px;">
                                                <tr>
                                                    <td width="50%"
                                                        style="padding:12px 15px; border-right:1px solid #e2e8f0;">
                                                        <div
                                                            style="font-size:11px; color:#718096; font-weight:bold; margin-bottom:2px;">
                                                            PID / PPID</div>
                                                        <div
                                                            style="font-family:monospace; font-size:13px; color:#2d3748;">
                                                            {{ payload.proc.pid if payload is defined and payload.proc
                                                            is defined and payload.proc.pid is defined and
                                                            payload.proc.pid is not none else 'N/A' }}
                                                            <span style="color:#cbd5e0;">/</span>
                                                            {{ payload.proc.ppid if payload is defined and payload.proc
                                                            is defined and payload.proc.ppid is defined and
                                                            payload.proc.ppid is not none else 'N/A' }}
                                                        </div>
                                                    </td>
                                                    <td width="50%" style="padding:12px 15px;">
                                                        <div
                                                            style="font-size:11px; color:#718096; font-weight:bold; margin-bottom:2px;">
                                                            TID</div>
                                                        <div
                                                            style="font-family:monospace; font-size:13px; color:#2d3748;">
                                                            {{ payload.proc.tid if payload is defined and payload.proc
                                                            is defined and payload.proc.tid is defined and
                                                            payload.proc.tid is not none else 'N/A' }}
                                                        </div>
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td width="50%"
                                                        style="padding:12px 15px; border-right:1px solid #e2e8f0; border-top:1px solid #e2e8f0;">
                                                        <div
                                                            style="font-size:11px; color:#718096; font-weight:bold; margin-bottom:2px;">
                                                            UID</div>
                                                        <div
                                                            style="font-family:monospace; font-size:13px; color:#2d3748;">
                                                            {{ payload.proc.uid if payload is defined and payload.proc
                                                            is defined and payload.proc.uid is defined and
                                                            payload.proc.uid is not none else 'N/A' }}
                                                        </div>
                                                    </td>
                                                    <td width="50%"
                                                        style="padding:12px 15px; border-top:1px solid #e2e8f0;">
                                                        <div
                                                            style="font-size:11px; color:#718096; font-weight:bold; margin-bottom:2px;">
                                                            GID</div>
                                                        <div
                                                            style="font-family:monospace; font-size:13px; color:#2d3748;">
                                                            {{ payload.proc.gid if payload is defined and payload.proc
                                                            is defined and payload.proc.gid is defined and
                                                            payload.proc.gid is not none else 'N/A' }}
                                                        </div>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Optional: Via -->
                            {% if payload is defined and payload.net is defined and payload.net.via is defined and
                            payload.net.via and payload.net.via.endpoint is defined %}
                            <div style="margin-bottom:10px;">
                                <span
                                    style="text-transform:uppercase; letter-spacing:0.05em; color:#a0aec0; font-size:11px; font-weight:700; display:block; margin-bottom:10px;">
                                    🛰️ Via
                                </span>
                                <div
                                    style="background-color:#edf2f7; color:#2d3748; padding:12px; border-radius:6px; font-family:Consolas, Monaco, monospace; font-size:12px; word-break:break-all; border:1px solid #e2e8f0;">
                                    {{ payload.net.via.endpoint }}
                                </div>
                            </div>
                            {% endif %}

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center"
                            style="background-color:#f8fafc; padding:25px; border-top:1px solid #e2e8f0;">
                            <p style="margin:0; color:#718096; font-size:12px; font-weight:600;">🛡️ Network Watcher •
                                {{ node or 'Unknown Node' }}</p>
                            <p style="margin:5px 0 0 0; color:#a0aec0; font-size:11px;">
                                Time: {{ time or 'Unknown' }}
                            </p>
                        </td>
                    </tr>

                </table>

                <p style="text-align:center; margin-top:25px; color:#a0aec0; font-size:11px;">
                    This is an automated security alert. Please do not reply directly to this email.
                </p>

            </td>
        </tr>
    </table>
</body>

</html>
